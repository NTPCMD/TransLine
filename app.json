{
  "expo": {
    "name": "Transline",
    "slug": "transline",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./Transline (2).png",
    "scheme": "transline",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./Transline (2).png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      [
        "@react-native-async-storage/async-storage"
      ],
      [
        "expo-notifications",
        {
          "icon": "./Transline (2).png",
          "color": "#C62828"
        }
      ]
    ],
    "notification": {
      "icon": "./Transline (2).png",
      "color": "#C62828"
    }
  }
}
